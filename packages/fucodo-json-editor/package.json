{
  "name": "fucodo.json-editor",
  "version": "0.1.0",
  "description": "Progressive-enhancement web component for a JSON <textarea>: syntax highlighting, JSON Schema validation, pretty-print on blur, minified on save.",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "exports": {
    ".": "./index.js",
    "./dist": "./dist/index.js",
    "./highlight-json.js": "./highlight-json.js",
    "./pretty-print.js": "./pretty-print.js"
  },
  "files": [
    "index.js",
    "highlight-json.js",
    "pretty-print.js",
    "style.scss",
    "dist"
  ],
  "sideEffects": [
    "./index.js",
    "./dist/index.js",
    "*.scss"
  ],
  "keywords": [
    "web-component",
    "custom-element",
    "json",
    "json-schema",
    "textarea",
    "syntax-highlighting",
    "progressive-enhancement"
  ],
  "license": "MIT",
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}